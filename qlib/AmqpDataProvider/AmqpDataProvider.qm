%modern
%allow-weak-references

%requires(reexport) DataProvider
%requires(reexport) ConnectionProvider
%requires amqp
%requires AmqpUtil

module AmqpDataProvider {
    version = "1.0";
    desc = "User module providing a data provider API for AMQP 1.0 messaging";
    author = "Qore Technologies, s.r.o.";
    url = "https://github.com/qoretechnologies/module-amqp";
    license = "MIT";
    init = sub () {
        # Register data provider factory
        DataProvider::registerFactory(new AmqpDataProviderFactory());

        # Register connection schemes
        ConnectionSchemeCache::registerScheme("amqp", AmqpDataProviderConnection::ConnectionScheme);
        ConnectionSchemeCache::registerScheme("amqps", AmqpDataProviderConnection::ConnectionScheme);

        # Register app in action catalog
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": AmqpDataProvider::AppName,
            "presentation_source_locale": "en",
            "display_name": "AMQP 1.0 Message Broker",
            "short_desc": "Send and receive messages via AMQP 1.0",
            "desc": "Connect to any [AMQP 1.0](https://www.amqp.org/) message broker "
                "(Apache ActiveMQ Artemis, RabbitMQ, Azure Service Bus, Amazon MQ, etc.) "
                "to integrate messaging into your workflows.\n\n"
                "**Use cases**:\n"
                "- **Order processing**: send order events to a queue for async processing\n"
                "- **Notifications**: publish alerts and notifications to topic subscribers\n"
                "- **System integration**: exchange data between microservices via message queues\n"
                "- **Event-driven workflows**: trigger actions when messages arrive\n\n"
                "**Supported operations**:\n"
                "- **Send**: publish messages to any address with full property support\n"
                "- **Receive**: observe incoming messages as real-time events\n"
                "- **Auto-discovery**: automatically discover broker addresses via the "
                "AMQP Management Protocol\n\n"
                "Supports both `amqp://` (plaintext) and `amqps://` (TLS-encrypted) connections.",
            "scheme": "amqp",
            "groups": (DataProvider::AppGroup::Messaging, DataProvider::AppGroup::ApiIntegration,),
            "logo": AmqpLogo,
            "logo_mime_type": MimeTypeSvg,
            "logo_file_name": "amqp-logo.svg",
        });

        # Register send action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": AmqpDataProvider::AppName,
            "path": "/{address}",
            "path_vars": {
                "address": <DataProviderPathVarInfo>{
                    "display_name": "AMQP Address",
                    "short_desc": "The queue or topic to send to",
                    "desc": "The AMQP address (queue or topic name) where the message "
                        "will be published.\n\n"
                        "Messages sent to a **queue** are delivered to a single consumer "
                        "(point-to-point). Messages sent to a **topic** are delivered to "
                        "all subscribers (publish-subscribe).",
                    "example_value": "orders",
                },
            },
            "action": "send",
            "display_name": "Send Message",
            "short_desc": "Publish a message to an AMQP queue or topic",
            "desc": "Sends a message to the specified AMQP address (queue or topic).\n\n"
                "The message **body** is required and can be any type — a string, "
                "structured data (hash/list), binary, or scalar value. Use "
                "`content_type` to indicate the format (e.g., `application/json`).\n\n"
                "**Common scenarios**:\n"
                "- Send an order event: `{\"order_id\": 123, \"total\": 49.99}` with "
                "`content_type: application/json`\n"
                "- Send a notification: `\"Low inventory alert\"` with "
                "`subject: alerts.inventory`\n"
                "- Send a binary payload: raw file data with "
                "`content_type: application/octet-stream`\n\n"
                "The response indicates whether the broker **accepted** the message.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                AmqpSendRequestDataType::Fields{"body",}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                AmqpSendRequestDataType::Fields - "body", {
                    "preselected": True,
                },
            ),
            "output_type": AmqpAddressDataProvider::ResponseType,
        });

        # Register receive event action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": AmqpDataProvider::AppName,
            "path": "/{address}/events",
            "path_vars": {
                "address": <DataProviderPathVarInfo>{
                    "display_name": "AMQP Address",
                    "short_desc": "The queue or topic to receive from",
                    "desc": "The AMQP address (queue or topic name) to listen on for "
                        "incoming messages.\n\n"
                        "Messages are delivered as events whenever they arrive on "
                        "this address.",
                    "example_value": "orders",
                },
            },
            "action": "receive",
            "display_name": "Receive Messages",
            "short_desc": "Listen for incoming messages on an AMQP address",
            "desc": "Observes incoming messages on the specified AMQP address and fires "
                "an event for each message received.\n\n"
                "Each event includes the message `body`, `content_type`, `message_id`, "
                "`correlation_id`, `reply_to`, `subject`, and any custom "
                "`application_properties` set by the sender.\n\n"
                "**Use this to**:\n"
                "- Process orders as they arrive on a queue\n"
                "- React to notifications from a topic\n"
                "- Trigger workflows when integration messages are received",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_AMQP_MESSAGE,
        });
    };
}

/** @mainpage AmqpDataProvider Module

    @tableofcontents

    @section amqpdataproviderintro AmqpDataProvider Module Introduction

    <img src="amqp-logo.svg" width="96" alt="AmqpDataProvider module logo"/>

    The %AmqpDataProvider module integrates AMQP 1.0 messaging with the
    @ref dataproviderintro "DataProvider" and @ref connectionproviderintro "ConnectionProvider" frameworks.
    It builds on @ref amqputilintro "AmqpUtil" and the @ref amqpintro "amqp binary module".

    - Send messages to a queue or topic through @ref DataProvider::AbstractDataProvider::doRequest() "doRequest()"
    - Receive messages as @ref AmqpDataProvider::EVENT_AMQP_MESSAGE "AMQP message events"
    - Expose configured addresses, optionally augmented by broker discovery
    - Use plaintext or TLS connections through the \c amqp:// and \c amqps:// schemes

    @anchor amqpdataprovider_classes
    @section amqpdataproviderapi API Overview

    |!Class|!Purpose
    |@ref AmqpDataProvider::AmqpDataProvider "AmqpDataProvider"|Root provider exposing broker addresses
    |@ref AmqpDataProvider::AmqpDataProviderFactory "AmqpDataProviderFactory"|Factory registered as \c amqp
    |@ref AmqpDataProvider::AmqpAddressDataProvider "AmqpAddressDataProvider"|Send messages to a selected address
    |@ref AmqpDataProvider::AmqpEventDataProvider "AmqpEventDataProvider"|Observe incoming messages on an address
    |@ref AmqpDataProvider::AmqpDataProviderConnection "AmqpDataProviderConnection"|Create providers through a named connection

    @section amqpdataproviderdocumentation Documentation

    - @anchor amqpdataprovider_hierarchy @anchor amqpdataprovider_factory @anchor amqpdataprovider_factory_options @anchor amqpdataprovider_connections @subpage amqpdataproviderconfiguration — provider paths, options, discovery, connections, and message contracts
    - @anchor amqpdataprovider_examples @anchor amqpdataprovider_examples_send @anchor amqpdataprovider_examples_management @subpage amqpdataprovidercookbook — sending and observing messages, plus command-line usage
    - @anchor amqpdataprovider_relnotes @subpage amqpdataproviderreleasenotes — version history
*/

/** @page amqpdataproviderconfiguration Provider Configuration and Message Contracts

    @tableofcontents

    @section amqpdataproviderconfigurationpaths Provider Paths

    The factory name is \c amqp. Create a provider through
    @ref DataProvider::DataProvider::getFactory() or construct @ref AmqpDataProvider::AmqpDataProvider directly.
    A provider created from options connects to the broker during construction.

    |!Path|!Provider|!Operation
    |Root|@ref AmqpDataProvider::AmqpDataProvider "AmqpDataProvider"|List configured or discovered addresses
    |<tt>/&lt;address&gt;</tt>|@ref AmqpDataProvider::AmqpAddressDataProvider "AmqpAddressDataProvider"|Send through @ref DataProvider::AbstractDataProvider::doRequest() "doRequest()"
    |<tt>/&lt;address&gt;/events</tt>|@ref AmqpDataProvider::AmqpEventDataProvider "AmqpEventDataProvider"|Observe incoming messages

    Address children must be present in the configured or discovered address list.
    Merely naming an arbitrary address in a provider path does not add it to that list.

    @section amqpdataproviderconfigurationoptions Factory Options

    These options are declared by @ref AmqpDataProvider::AmqpDataProvider::ConstructorOptions "ConstructorOptions".
    See @ref amqpdataprovidercookbook for complete examples.

    |!Option|!Type|!Default|!Meaning
    |\c url|string|Required|Broker URL using \c amqp:// or \c amqps://, optionally including credentials
    |\c addresses|string|No addresses|Comma-separated addresses to expose; surrounding whitespace is trimmed
    |\c use_management|bool|\c False|Append addresses discovered through the broker's AMQP Management Protocol
    |\c username|string|From URL|SASL PLAIN username; explicit credentials override URL credentials
    |\c password|string|From URL|SASL PLAIN password; sensitive value
    |\c timeout_ms|int|\c 30000|Timeout passed to event providers for each receive operation, in milliseconds

    Manual addresses remain available when management discovery is unsupported or fails.
    Discovery adds unique broker addresses to the configured list; it does not create queues or topics.
    Provision a queue or subscription before publishing. A broker can accept a message even when no queue
    or subscriber is available to receive it; acceptance does not establish a route for future consumers.
    With neither configured addresses nor successful discovery, the root has no address children.

    The \c timeout_ms provider option controls event receives; send operations use the underlying
    @ref Amqp::AmqpClient::send() "AmqpClient::send()" defaults. For custom native connection options,
    create an @ref Amqp::AmqpClient "AmqpClient" from @ref Qore::Amqp::AmqpConnectionOptions "AmqpConnectionOptions"
    and pass that connected client to @ref AmqpDataProvider::AmqpDataProvider "AmqpDataProvider".
    See @ref amqp_connection_optionsguide for TLS, SASL, and reconnect settings.

    @section amqpdataproviderconfigurationconnections Connection Schemes

    @ref AmqpDataProvider::AmqpDataProviderConnection registers \c amqp:// for plaintext AMQP 1.0 and
    \c amqps:// for TLS. Its connection options are \c addresses, \c use_management, and \c timeout_ms;
    credentials belong in the connection URL. Call
    @ref AmqpDataProvider::AmqpDataProviderConnection::getDataProvider() "getDataProvider()" to create the provider.
    See @ref connectionproviderintro "ConnectionProvider" for named connection management.

    @section amqpdataproviderconfigurationmessages Sending and Receiving

    @ref AmqpDataProvider::AmqpSendRequestDataType defines the send request: \c body is required;
    \c content_type, \c message_id, \c correlation_id, \c reply_to, \c subject, and
    \c application_properties are optional message metadata. Setting \c content_type does not serialize the
    body: AMQP values use the @ref amqptypemapguide "native type mapping". For format conversion, use
    @ref Amqp::AmqpMessageConverter "AmqpMessageConverter" before sending.

    @ref AmqpDataProvider::AmqpSendResponseDataType describes the response's \c settled and \c state fields.
    Inspect the delivery state as well as settlement; settlement alone is not a guarantee of acceptance.
    See @ref Qore::Amqp::AmqpDeliveryInfo "AmqpDeliveryInfo".

    Incoming @ref AmqpDataProvider::EVENT_AMQP_MESSAGE "AMQP message events" carry the fields described by
    @ref AmqpDataProvider::AmqpMessageEventDataType. Register observers before calling
    @ref AmqpDataProvider::AmqpEventDataProvider::observersReady() "observersReady()" and call
    @ref AmqpDataProvider::AmqpEventDataProvider::stopEvents() "stopEvents()" before closing the shared client.
*/

/** @page amqpdataprovidercookbook Messaging Cookbook

    @tableofcontents

    Examples require an AMQP 1.0 broker with a queue named \c orders already configured.
    Replace the demonstration URL with your broker URL. See @ref amqpdataproviderconfiguration for options.

    @section amqpdataprovidercookbooksend Send a Message

    Sharing an @ref Amqp::AmqpClient "AmqpClient" gives the caller explicit control over connection cleanup.
    @ref DataProvider::AbstractDataProvider::getChildProviderEx() "getChildProviderEx()" rejects unknown addresses.

    @code{.py}
%modern
%requires AmqpDataProvider
%requires AmqpUtil

AmqpClient client("amqp://guest:guest\@localhost:5672");
client.connect();
on_exit client.close();
AmqpDataProvider provider(client, ("orders",));
AbstractDataProvider address = provider.getChildProviderEx("orders");
hash<auto> result = address.doRequest({
    "body": {"order_id": 123, "status": "ready"},
    "subject": "order.ready",
});
printf("Delivery state: %s (settled: %y)\n", result.state, result.settled);
    @endcode

    @section amqpdataprovidercookbookreceive Receive an Event

    This example receives one event or raises a queue timeout after five seconds.
    @ref DataProvider::Observer "Observer" implements the event callback;
    @ref Qore::Thread::Queue "Queue" transfers the event from the background observer to the caller.

    @code{.py}
%modern
%requires AmqpDataProvider
%requires AmqpUtil

class MessageObserver inherits Observer {
    private {
        Queue<hash<auto>> received;
    }

    constructor(Queue<hash<auto>> queue) {
        self.received = queue;
    }

    update(string event_id, hash<auto> data) {
        self.received.push(data);
    }
}

AmqpClient client("amqp://guest:guest\@localhost:5672");
client.connect();
on_exit client.close();
AmqpEventDataProvider events(client, "orders", 1000);
Queue<hash<auto>> received();
events.registerObserver(new MessageObserver(received), EVENT_AMQP_MESSAGE);
events.observersReady();
on_exit events.stopEvents();
hash<auto> message = received.get(5000);
printf("Received: %y\n", message.body);
    @endcode

    @section amqpdataprovidercookbookcli Command-Line Usage

    Use \c qdp to send through the \c amqp factory:

    @verbatim
qdp 'amqp{url=amqp://guest:guest@localhost:5672,addresses=orders}/orders' dor body=Hello
    @endverbatim

    To list addresses discovered through the AMQP Management Protocol:

    @verbatim
qdp 'amqp{url=amqp://guest:guest@localhost:5672,use_management=true}' children
    @endverbatim
*/

