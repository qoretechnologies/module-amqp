%modern
%allow-weak-references

%requires(reexport) DataProvider
%requires(reexport) ConnectionProvider
%requires amqp
%requires AmqpUtil

module AmqpDataProvider {
    version = "1.0";
    desc = "User module providing a data provider API for AMQP 1.0 messaging";
    author = "Qore Technologies, s.r.o.";
    url = "https://github.com/qoretechnologies/module-amqp";
    license = "MIT";
    init = sub () {
        # Register data provider factory
        DataProvider::registerFactory(new AmqpDataProviderFactory());

        # Register connection schemes
        ConnectionSchemeCache::registerScheme("amqp", AmqpDataProviderConnection::ConnectionScheme);
        ConnectionSchemeCache::registerScheme("amqps", AmqpDataProviderConnection::ConnectionScheme);

        # Register app in action catalog
        DataProviderActionCatalog::registerApp(<DataProviderAppInfo>{
            "name": AmqpDataProvider::AppName,
            "display_name": "AMQP 1.0 Message Broker",
            "short_desc": "Send and receive messages via AMQP 1.0",
            "desc": "Connect to any [AMQP 1.0](https://www.amqp.org/) message broker "
                "(Apache ActiveMQ Artemis, RabbitMQ, Azure Service Bus, Amazon MQ, etc.) "
                "to integrate messaging into your workflows.\n\n"
                "**Use cases**:\n"
                "- **Order processing**: send order events to a queue for async processing\n"
                "- **Notifications**: publish alerts and notifications to topic subscribers\n"
                "- **System integration**: exchange data between microservices via message queues\n"
                "- **Event-driven workflows**: trigger actions when messages arrive\n\n"
                "**Supported operations**:\n"
                "- **Send**: publish messages to any address with full property support\n"
                "- **Receive**: observe incoming messages as real-time events\n"
                "- **Auto-discovery**: automatically discover broker addresses via the "
                "AMQP Management Protocol\n\n"
                "Supports both `amqp://` (plaintext) and `amqps://` (TLS-encrypted) connections.",
            "scheme": "amqp",
            "groups": (DataProvider::AppGroup::Messaging, DataProvider::AppGroup::ApiIntegration,),
            "logo": AmqpLogo,
            "logo_mime_type": MimeTypeSvg,
            "logo_file_name": "amqp-logo.svg",
        });

        # Register send action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": AmqpDataProvider::AppName,
            "path": "/{address}",
            "path_vars": {
                "address": <DataProviderPathVarInfo>{
                    "display_name": "AMQP Address",
                    "short_desc": "The queue or topic to send to",
                    "desc": "The AMQP address (queue or topic name) where the message "
                        "will be published.\n\n"
                        "Messages sent to a **queue** are delivered to a single consumer "
                        "(point-to-point). Messages sent to a **topic** are delivered to "
                        "all subscribers (publish-subscribe).",
                    "example_value": "orders",
                },
            },
            "action": "send",
            "display_name": "Send Message",
            "short_desc": "Publish a message to an AMQP queue or topic",
            "desc": "Sends a message to the specified AMQP address (queue or topic).\n\n"
                "The message **body** is required and can be any type — a string, "
                "structured data (hash/list), binary, or scalar value. Use "
                "`content_type` to indicate the format (e.g., `application/json`).\n\n"
                "**Common scenarios**:\n"
                "- Send an order event: `{\"order_id\": 123, \"total\": 49.99}` with "
                "`content_type: application/json`\n"
                "- Send a notification: `\"Low inventory alert\"` with "
                "`subject: alerts.inventory`\n"
                "- Send a binary payload: raw file data with "
                "`content_type: application/octet-stream`\n\n"
                "The response indicates whether the broker **accepted** the message.",
            "action_code": DPAT_API,
            "options": DataProviderActionCatalog::getActionOptionFromFields(
                AmqpSendRequestDataType::Fields{"body",}, {
                    "preselected": True,
                    "required": True,
                },
            ) + DataProviderActionCatalog::getActionOptionFromFields(
                AmqpSendRequestDataType::Fields - "body", {
                    "preselected": True,
                },
            ),
            "output_type": AmqpAddressDataProvider::ResponseType,
        });

        # Register receive event action
        DataProviderActionCatalog::registerAction(<DataProviderActionInfo>{
            "app": AmqpDataProvider::AppName,
            "path": "/{address}/events",
            "path_vars": {
                "address": <DataProviderPathVarInfo>{
                    "display_name": "AMQP Address",
                    "short_desc": "The queue or topic to receive from",
                    "desc": "The AMQP address (queue or topic name) to listen on for "
                        "incoming messages.\n\n"
                        "Messages are delivered as events whenever they arrive on "
                        "this address.",
                    "example_value": "orders",
                },
            },
            "action": "receive",
            "display_name": "Receive Messages",
            "short_desc": "Listen for incoming messages on an AMQP address",
            "desc": "Observes incoming messages on the specified AMQP address and fires "
                "an event for each message received.\n\n"
                "Each event includes the message `body`, `content_type`, `message_id`, "
                "`correlation_id`, `reply_to`, `subject`, and any custom "
                "`application_properties` set by the sender.\n\n"
                "**Use this to**:\n"
                "- Process orders as they arrive on a queue\n"
                "- React to notifications from a topic\n"
                "- Trigger workflows when integration messages are received",
            "action_code": DPAT_EVENT,
            "action_val": EVENT_AMQP_MESSAGE,
        });
    };
}

/** @mainpage AmqpDataProvider Module

    @tableofcontents

    @section amqpdataproviderintro AmqpDataProvider Module Introduction

    The %AmqpDataProvider module integrates AMQP 1.0 messaging into Qore's data
    provider framework, enabling AMQP send/receive operations to be used alongside
    REST, gRPC, SOAP, and other protocols through a uniform API.

    Key capabilities:
    - <b>Send messages</b>: send messages to any AMQP address via \c doRequest()
    - <b>Observable events</b>: receive messages as observable events via the
      DataProvider observer pattern
    - <b>Auto-discovery</b>: when \c use_management is \c True, the broker is
      queried via the AMQP Management Protocol to auto-discover addresses
    - <b>Connection management</b>: \c amqp:// and \c amqps:// URL schemes
      integrate with Qore's connection framework

    @subsection amqpdataprovider_hierarchy Provider Hierarchy

    @verbatim
<root>                          (AmqpDataProvider)
  └── <address>                 (AmqpAddressDataProvider — doRequest for send)
        └── events              (AmqpEventDataProvider — observable incoming messages)
    @endverbatim

    @subsection amqpdataprovider_classes Provided Classes

    - @ref AmqpDataProvider::AmqpDataProvider "AmqpDataProvider": root provider
      with address discovery
    - @ref AmqpDataProvider::AmqpDataProviderFactory "AmqpDataProviderFactory":
      factory for creating providers from options
    - @ref AmqpDataProvider::AmqpAddressDataProvider "AmqpAddressDataProvider":
      address-level provider supporting send via \c doRequest()
    - @ref AmqpDataProvider::AmqpEventDataProvider "AmqpEventDataProvider":
      observable event provider for incoming messages
    - @ref AmqpDataProvider::AmqpDataProviderConnection "AmqpDataProviderConnection":
      connection provider with \c amqp:// and \c amqps:// URL schemes

    @section amqpdataprovider_factory AmqpDataProvider Factory

    The name of the AMQP data provider factory is <b><tt>amqp</tt></b>.

    @subsection amqpdataprovider_factory_options Factory Options

    | Option | Type | Description |
    |--------|------|-------------|
    | \c url | string | Broker URL (\c amqp://host:port or \c amqps://host:port) |
    | \c addresses | string | Comma-separated list of AMQP addresses |
    | \c use_management | bool | Auto-discover addresses via AMQP Management Protocol (default: \c False) |
    | \c username | string | SASL username |
    | \c password | string | SASL password (sensitive) |
    | \c timeout_ms | int | Default timeout in milliseconds (default: \c 30000) |

    @section amqpdataprovider_examples AmqpDataProvider Examples

    @subsection amqpdataprovider_examples_send Send a Message

    @verbatim qdp 'amqp{url=amqp://guest:guest@localhost:5672,addresses=my-queue}/my-queue' dor body=Hello
    @endverbatim

    @subsection amqpdataprovider_examples_management Auto-Discovery

    @verbatim qdp 'amqp{url=amqp://guest:guest@localhost:5672,use_management=true}' children
    @endverbatim

    @section amqpdataprovider_connections Connection Schemes

    The module registers two connection URL schemes:
    - \c amqp://host:port — plaintext AMQP 1.0
    - \c amqps://host:port — TLS-encrypted AMQP 1.0

    @section amqpdataprovider_relnotes Release Notes

    @subsection amqpdataprovider_v1_0 AmqpDataProvider v1.0
    - initial release
    - @ref AmqpDataProvider::AmqpDataProvider "AmqpDataProvider": root provider with
      address discovery via manual config or AMQP Management Protocol
    - @ref AmqpDataProvider::AmqpAddressDataProvider "AmqpAddressDataProvider":
      address-level send via \c doRequest()
    - @ref AmqpDataProvider::AmqpEventDataProvider "AmqpEventDataProvider":
      observable event provider for incoming messages
    - @ref AmqpDataProvider::AmqpDataProviderConnection "AmqpDataProviderConnection":
      \c amqp:// and \c amqps:// connection schemes
*/

#! Contains all public definitions in the AmqpDataProvider module
public namespace AmqpDataProvider {
    #! AMQP logo in SVG format for the action catalog
    public const AmqpLogo = File::readTextFile(get_script_dir() + "/amqp-logo.svg");
}
