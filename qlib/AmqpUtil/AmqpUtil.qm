%modern

%requires amqp
%requires DataProvider

# Optional serialization modules loaded at runtime via call_function()
# in AmqpMessageConverter — no %try-module needed here
%try-module json >= 1.0
%endtry

%try-module yaml >= 1.0
%endtry

%try-module xml >= 1.0
%endtry

module AmqpUtil {
    version = "1.0";
    desc = "Qore AMQP 1.0 utility module";
    author = "Qore Technologies, s.r.o.";
    url = "https://github.com/qoretechnologies/module-amqp";
    license = "MIT";
}

#! Main Amqp namespace
/** All public declarations in the %AmqpUtil module are defined in this namespace.
*/
public namespace Amqp {
}

/** @mainpage AmqpUtil Module

    @tableofcontents

    @section amqputilintro AmqpUtil Module Introduction

    The %AmqpUtil module provides a high-level pure-Qore API for AMQP 1.0 messaging
    built on top of the @ref amqpintro "amqp binary module" (which wraps Apache Qpid Proton C++).

    This module provides convenient wrapper classes for common messaging patterns:
    - @ref Amqp::AmqpClient "AmqpClient": central client class for connection management,
      sending, and receiving
    - @ref Amqp::AmqpProducer "AmqpProducer": dedicated producer for a specific address
    - @ref Amqp::AmqpConsumer "AmqpConsumer": dedicated consumer with durable subscription
      and filter support
    - @ref Amqp::AmqpRequestReply "AmqpRequestReply": request-reply pattern with automatic
      correlation ID matching
    - @ref Amqp::AmqpManagementClient "AmqpManagementClient": broker introspection via the
      AMQP Management Protocol

    For the data provider API integration (factory, connections, action catalog),
    see the @ref amqpdataproviderintro "AmqpDataProvider module".

    @section amqputildocumentation Documentation

    - @anchor amqputil_client_usage @anchor amqputil_simple @anchor amqputil_producer_consumer @anchor amqputil_requestreply @anchor amqputil_transactions @anchor amqputil_durable @anchor amqputil_management @subpage amqputilcookbook — send, receive, request-reply, transactions, and broker discovery
    - @anchor amqputilrelnotes @subpage amqputilreleasenotes — version history
*/

/** @page amqputilcookbook Messaging Cookbook

    @tableofcontents

    These examples require an AMQP 1.0 broker with the example queues already configured.
    Replace the demonstration URL with your broker URL. Publishing before a queue or subscription exists
    can discard messages even when the broker accepts the send.
    See @ref amqp_connection_optionsguide for authentication and TLS settings.
    Each example closes the connection even if an operation raises an exception.

    @section amqputilcookbooksimple Simple Send/Receive

    Use @ref Amqp::AmqpClient::send() and @ref Amqp::AmqpClient::receive() for one-off operations.

    @code{.py}
%modern
%requires amqp
%requires AmqpUtil

AmqpClient client("amqp://guest:guest\@localhost:5672");
client.connect();
on_exit client.close();

# Simple send
client.send("my-queue", "Hello, AMQP!");

# Simple receive
*AmqpMessage msg = client.receive("my-queue", 5s);
if (msg) {
    printf("Received: %y\n", msg.getBody());
}
    @endcode

    @section amqputilcookbookproducerconsumer Producer/Consumer Pattern

    Reuse @ref Amqp::AmqpProducer and @ref Amqp::AmqpConsumer for repeated operations on an address.

    @code{.py}
%modern
%requires amqp
%requires AmqpUtil
AmqpClient client("amqp://guest:guest\@localhost:5672");
client.connect();
on_exit client.close();

AmqpProducer producer = client.createProducer("my-queue");
producer.send("Message 1");
producer.send("Message 2", <AmqpMessageProperties>{"content_type": "text/plain"});

AmqpConsumer consumer = client.createConsumer("my-queue");
while (*AmqpMessage msg = consumer.receive(5s)) {
    printf("Got: %y\n", msg.getBody());
}
    @endcode

    @section amqputilcookbookrequestreply Request-Reply Pattern

    Use @ref Amqp::AmqpRequestReply::request() with a service listening on the request address.

    @code{.py}
%modern
%requires amqp
%requires AmqpUtil
AmqpClient client("amqp://guest:guest\@localhost:5672");
client.connect();
on_exit client.close();

AmqpRequestReply rr(client, "request-queue");
on_exit rr.close();
AmqpMessage response = rr.request("ping", 10s);
printf("Reply: %y\n", response.getBody());
    @endcode

    @section amqputilcookbooktransactions Transactions

    Use @ref Amqp::AmqpClient::beginTransaction(), @ref Amqp::AmqpClient::commitTransaction(), and
    @ref Amqp::AmqpClient::rollbackTransaction() with a broker supporting AMQP transactions.

    @code{.py}
%modern
%requires amqp
%requires AmqpUtil
AmqpClient client("amqp://guest:guest\@localhost:5672");
client.connect();
on_exit client.close();

client.beginTransaction();
on_error client.rollbackTransaction();
client.send("my-queue", "transacted message 1");
client.send("my-queue", "transacted message 2");
client.commitTransaction();
    @endcode

    @section amqputilcookbookdurable Durable Subscriptions

    Use @ref Amqp::AmqpConsumer::closeDurable() to retain a subscription and
    @ref Amqp::AmqpConsumer::unsubscribe() to remove it. The broker must support durable subscriptions.

    @code{.py}
%modern
%requires amqp
%requires AmqpUtil
AmqpClient client("amqp://guest:guest\@localhost:5672");
client.connect();
on_exit client.close();

AmqpConsumer consumer = client.createDurableConsumer("topic/news", "my-sub");
*AmqpMessage msg = consumer.receive(5s);
consumer.closeDurable();  # close without unsubscribing

# Later, reconnect and resume
consumer = client.createDurableConsumer("topic/news", "my-sub");
# Messages accumulated while disconnected are available

consumer.unsubscribe();  # permanently remove subscription
    @endcode

    @section amqputilcookbookmanagement Broker Introspection

    Use @ref Amqp::AmqpManagementClient::queryAddresses() with a broker supporting the AMQP Management Protocol.

    @code{.py}
%modern
%requires amqp
%requires AmqpUtil
AmqpClient client("amqp://guest:guest\@localhost:5672");
client.connect();
on_exit client.close();

AmqpManagementClient mgmt = client.getManagementClient();
list<hash<AmqpAddressInfo>> addresses = mgmt.queryAddresses();
foreach hash<AmqpAddressInfo> addr in (addresses) {
    printf("Address: %s (type: %s)\n", addr.name, addr.routing_type);
}
    @endcode

*/

