#include "amqp-module.h"
#include "QC_AmqpMessage.h"
#include "QoreAmqpMessage.h"

//! Properties for an AMQP 1.0 message
/** These properties correspond to the AMQP 1.0 message properties, application-properties,
    and annotation sections.

*/
hashdecl Qore::Amqp::AmqpMessageProperties {
    //! The message identifier (string, int, binary, or UUID string)
    auto message_id;

    //! Correlation identifier for request-reply (string, int, binary, or UUID string)
    auto correlation_id;

    //! The address of the node to send replies to
    *string reply_to;

    //! MIME content type of the message body (e.g., "application/json")
    *string content_type;

    //! MIME content encoding of the message body (e.g., "gzip")
    *string content_encoding;

    //! The subject of the message
    *string subject;

    //! The address of the node the message is intended for
    *string to;

    //! The group this message belongs to
    *string group_id;

    //! The sequence number within the group
    *int group_sequence;

    //! The group the reply message belongs to
    *string reply_to_group_id;

    //! Absolute expiry time of the message
    *date expiry_time;

    //! Creation time of the message
    *date creation_time;

    //! Application-specific properties (key-value pairs)
    *hash<auto> application_properties;

    //! Delivery annotations (key-value pairs set by intermediaries)
    *hash<auto> delivery_annotations;

    //! Message annotations (key-value pairs for infrastructure use)
    *hash<auto> message_annotations;

    //! Footer properties (key-value pairs at the end of the message)
    *hash<auto> footer;
}

//! The AmqpMessage class represents an AMQP 1.0 message with a body and properties
/**
    @par Example: Creating a message with a string body
    @code{.py}
%requires amqp

AmqpMessage msg("Hello, World!");
    @endcode

    @par Example: Creating a message with properties
    @code{.py}
AmqpMessage msg({"key": "value"}, <AmqpMessageProperties>{
    "content_type": "application/json",
    "message_id": "msg-001",
    "application_properties": {"color": "red"},
});
    @endcode

*/
qclass AmqpMessage [arg=QoreAmqpMessage* msg; ns=Qore::Amqp];

//! Creates a new AmqpMessage with the given body and optional properties
/** @param body the message body (string, binary, hash, list, int, float, bool, date, or NOTHING)
    @param properties optional message properties

    @par Example:
    @code{.py}
AmqpMessage msg("Hello, World!");
AmqpMessage msg2({"key": "value"}, <AmqpMessageProperties>{"content_type": "application/json"});
    @endcode

*/
AmqpMessage::constructor(auto body, *hash<AmqpMessageProperties> properties) {
    self->setPrivate(CID_AMQPMESSAGE, new QoreAmqpMessage(body, properties, xsink));
}

//! Returns the message body
/** @return the message body value

    @par Example:
    @code{.py}
auto body = msg.getBody();
    @endcode

*/
auto AmqpMessage::getBody() [flags=RET_VALUE_ONLY] {
    return msg->getBody(xsink);
}

//! Returns all message properties
/** @return the message properties

    @par Example:
    @code{.py}
hash<AmqpMessageProperties> props = msg.getProperties();
    @endcode

*/
hash<AmqpMessageProperties> AmqpMessage::getProperties() [flags=RET_VALUE_ONLY] {
    return msg->getProperties(xsink);
}

//! Returns the application properties
/** @return the application properties hash, or NOTHING if not set

    @par Example:
    @code{.py}
*hash<auto> app_props = msg.getApplicationProperties();
    @endcode

*/
*hash<auto> AmqpMessage::getApplicationProperties() [flags=RET_VALUE_ONLY] {
    return msg->getApplicationProperties(xsink);
}

//! Returns the content type
/** @return the content type string, or NOTHING if not set

    @par Example:
    @code{.py}
*string ct = msg.getContentType();
    @endcode

*/
*string AmqpMessage::getContentType() [flags=RET_VALUE_ONLY] {
    return msg->getContentType(xsink);
}

//! Returns the message ID
/** @return the message ID (string, int, binary, or UUID string), or NOTHING if not set

    @par Example:
    @code{.py}
auto id = msg.getMessageId();
    @endcode

*/
auto AmqpMessage::getMessageId() [flags=RET_VALUE_ONLY] {
    return msg->getMessageId(xsink);
}

//! Returns the correlation ID
/** @return the correlation ID (string, int, binary, or UUID string), or NOTHING if not set

    @par Example:
    @code{.py}
auto cid = msg.getCorrelationId();
    @endcode

*/
auto AmqpMessage::getCorrelationId() [flags=RET_VALUE_ONLY] {
    return msg->getCorrelationId(xsink);
}

//! Returns the reply-to address
/** @return the reply-to address string, or NOTHING if not set

    @par Example:
    @code{.py}
*string reply_to = msg.getReplyTo();
    @endcode

*/
*string AmqpMessage::getReplyTo() [flags=RET_VALUE_ONLY] {
    return msg->getReplyTo(xsink);
}

//! Returns the message subject
/** @return the subject string, or NOTHING if not set

    @par Example:
    @code{.py}
*string subj = msg.getSubject();
    @endcode

*/
*string AmqpMessage::getSubject() [flags=RET_VALUE_ONLY] {
    return msg->getSubject(xsink);
}

//! Returns the delivery tag for received messages
/** The delivery tag is a binary identifier assigned by the broker when a message
    is received. It is used to acknowledge, reject, or release the message.

    For messages created locally (not received), this returns NOTHING.

    @return the delivery tag as binary data, or NOTHING if not a received message

    @par Example:
    @code{.py}
*AmqpMessage msg = conn.receive(receiver, 5s);
if (msg) {
    printf("Received: %y\n", msg.getBody());
    # Use the delivery tag to acknowledge the message
    *binary tag = msg.getDeliveryTag();
    if (tag) {
        conn.accept(tag);
    }
}
    @endcode

*/
*binary AmqpMessage::getDeliveryTag() [flags=CONSTANT] {
    return msg->getDeliveryTag();
}
