    AmqpUtil module test suite (requires broker via AMQP_TEST_URL)
*/

%modern

%requires QUnit
%requires amqp
%requires AmqpUtil

%exec-class AmqpUtilTest

public class AmqpUtilTest inherits QUnit::Test {
    private {
        *string url;
        int test_counter = 0;
    }

    constructor() : Test("AmqpUtilTest", "1.0") {
        url = ENV.AMQP_TEST_URL;
        if (!url) {
            printf("AMQP_TEST_URL not set, skipping AmqpUtil tests\n");
            set_return_value(0);
            return;
        }

        # AmqpClient basics
        addTestCase("client connect and disconnect", \testClientConnectDisconnect());
        addTestCase("client from options hash", \testClientFromOptions());
        addTestCase("client isConnected state", \testClientIsConnected());

        # AmqpClient send/receive
        addTestCase("client send and receive string", \testClientSendReceiveString());
        addTestCase("client send and receive hash", \testClientSendReceiveHash());
        addTestCase("client send and receive with properties", \testClientSendReceiveProperties());
        addTestCase("client sendMessage", \testClientSendMessage());
        addTestCase("client receive timeout", \testClientReceiveTimeout());
        addTestCase("client sender caching", \testClientSenderCaching());

        # AmqpProducer
        addTestCase("producer send", \testProducerSend());
        addTestCase("producer sendMessage", \testProducerSendMessage());
        addTestCase("producer with default opts", \testProducerDefaultOpts());

        # AmqpConsumer
        addTestCase("consumer receive", \testConsumerReceive());
        addTestCase("consumer accept via delivery tag", \testConsumerAccept());
        addTestCase("consumer multiple messages", \testConsumerMultiple());
        addTestCase("consumer isDurable", \testConsumerIsDurable());
        addTestCase("consumer non-durable closeDurable throws", \testConsumerNonDurableCloseThrows());
        addTestCase("consumer non-durable unsubscribe throws", \testConsumerNonDurableUnsubscribeThrows());

        # AmqpRequestReply
        addTestCase("request-reply pattern", \testRequestReply());
        addTestCase("request-reply timeout", \testRequestReplyTimeout());

        # AmqpProducer extended
        addTestCase("producer sendBatch", \testProducerSendBatch());
        addTestCase("producer close", \testProducerClose());

        # AmqpConsumer extended
        addTestCase("consumer close", \testConsumerClose());
        addTestCase("consumer reject", \testConsumerReject());
        addTestCase("consumer release", \testConsumerRelease());

        # AmqpClient link close
        addTestCase("client closeSender", \testClientCloseSender());
        addTestCase("client closeReceiver", \testClientCloseReceiver());

        # AmqpClient batch and shared
        addTestCase("client sendBatch", \testClientSendBatch());
        addTestCase("client createSharedConsumer", \testClientCreateSharedConsumer());

        # AmqpClient auto-convert
        addTestCase("client setAutoConvert and receiveAndDecode", \testClientAutoConvert());

        # AmqpClient durable consumer
        addTestCase("client createDurableConsumer", \testClientDurableConsumer());

        # AmqpManagementClient
        addTestCase("management queryAddresses", \testManagementQueryAddresses());
        addTestCase("management queryQueues", \testManagementQueryQueues());

        # Transaction pass-through
        addTestCase("client transaction methods", \testClientTransaction());
        addTestCase("client transaction commit delivers", \testClientTxnCommit());
        addTestCase("client transaction rollback discards", \testClientTxnRollback());
        addTestCase("client commit without begin throws", \testClientTxnCommitNoBegin());
        addTestCase("client rollback without begin throws", \testClientTxnRollbackNoBegin());

        set_return_value(main());
    }

    private string getUniqueAddress() {
        return sprintf("test-amqputil-%d-%d", getpid(), ++test_counter);
    }

    private AmqpClient getClient() {
        AmqpClient client(url);
        client.connect();
        return client;
    }

    # --- AmqpClient basics ---

    testClientConnectDisconnect() {
        AmqpClient client(url);
        client.connect();
        assertEq(True, client.isConnected());
        client.close();
        assertEq(False, client.isConnected());
    }

    testClientFromOptions() {
        AmqpClient client(<AmqpConnectionOptions>{"url": url});
        client.connect();
        assertEq(True, client.isConnected());
        client.close();
    }

    testClientIsConnected() {
        AmqpClient client(url);
        assertEq(False, client.isConnected());
        client.connect();
        assertEq(True, client.isConnected());
        client.close();
        assertEq(False, client.isConnected());
    }

    # --- AmqpClient send/receive ---

    testClientSendReceiveString() {
        string addr = getUniqueAddress();
        AmqpClient client = getClient();
        on_exit client.close();

        # Create receiver first so the queue exists before sending
        AmqpConsumer consumer = client.createConsumer(addr);
        client.send(addr, "Hello from AmqpClient!");
        *AmqpMessage msg = consumer.receive(10s);
        @assert(msg);
        assertEq("Hello from AmqpClient!", msg.getBody());
    }

    testClientSendReceiveHash() {
        string addr = getUniqueAddress();
        AmqpClient client = getClient();
        on_exit client.close();

        # Create receiver first so the queue exists before sending
        AmqpConsumer consumer = client.createConsumer(addr);
        hash<auto> data = {"name": "test", "count": 42};
        client.send(addr, data);
        *AmqpMessage msg = consumer.receive(10s);
        @assert(msg);
        hash<auto> body = msg.getBody();
        assertEq("test", body.name);
        assertEq(42, body.count);
    }

    testClientSendReceiveProperties() {
        string addr = getUniqueAddress();
        AmqpClient client = getClient();
        on_exit client.close();

        # Create receiver first so the queue exists before sending
        AmqpConsumer consumer = client.createConsumer(addr);
        client.send(addr, "with props", <AmqpMessageProperties>{
            "content_type": "text/plain",
            "message_id": "util-msg-001",
            "subject": "test-subject",
        });
        *AmqpMessage msg = consumer.receive(10s);
        @assert(msg);
        assertEq("with props", msg.getBody());
        assertEq("text/plain", msg.getContentType());
        assertEq("util-msg-001", msg.getMessageId());
        assertEq("test-subject", msg.getSubject());
    }

    testClientSendMessage() {
        string addr = getUniqueAddress();
        AmqpClient client = getClient();
        on_exit client.close();

        # Create receiver first so the queue exists before sending
        AmqpConsumer consumer = client.createConsumer(addr);
        AmqpMessage outgoing(42);
        client.sendMessage(addr, outgoing);
        *AmqpMessage msg = consumer.receive(10s);
        @assert(msg);
        assertEq(42, msg.getBody());
    }

    testClientReceiveTimeout() {
        string addr = getUniqueAddress();
        AmqpClient client = getClient();
        on_exit client.close();

        *AmqpMessage msg = client.receive(addr, 1s);
        assertNothing(msg);
    }

    testClientSenderCaching() {
        string addr = getUniqueAddress();
        AmqpClient client = getClient();
        on_exit client.close();

        # Create receiver first so the queue exists before sending
        AmqpConsumer consumer = client.createConsumer(addr);

        # Send twice to same address — should reuse sender
        client.send(addr, "msg-1");
        client.send(addr, "msg-2");

        *AmqpMessage msg1 = consumer.receive(10s);
        @assert(msg1);
        assertEq("msg-1", msg1.getBody());

        *AmqpMessage msg2 = consumer.receive(10s);
        @assert(msg2);
        assertEq("msg-2", msg2.getBody());
    }

    # --- AmqpProducer ---

    testProducerSend() {
        string addr = getUniqueAddress();
        AmqpClient client = getClient();
        on_exit client.close();

        # Create receiver first so the queue exists before sending
        AmqpConsumer consumer = client.createConsumer(addr);
        AmqpProducer producer = client.createProducer(addr);
        producer.send("producer msg");

        *AmqpMessage msg = consumer.receive(10s);
        @assert(msg);
        assertEq("producer msg", msg.getBody());
    }

    testProducerSendMessage() {
        string addr = getUniqueAddress();
        AmqpClient client = getClient();
        on_exit client.close();

        # Create receiver first so the queue exists before sending
        AmqpConsumer consumer = client.createConsumer(addr);
        AmqpProducer producer = client.createProducer(addr);
        producer.sendMessage(new AmqpMessage("via sendMessage"));

        *AmqpMessage msg = consumer.receive(10s);
        @assert(msg);
        assertEq("via sendMessage", msg.getBody());
    }

    testProducerDefaultOpts() {
        string addr = getUniqueAddress();
        AmqpClient client = getClient();
        on_exit client.close();

        # Create receiver first so the queue exists before sending
        AmqpConsumer consumer = client.createConsumer(addr);
        # Create producer with default send options
        AmqpProducer producer = client.createProducer(addr, <AmqpSendOptions>{
            "durable": True,
        });
        @assert(producer.getSenderName());
        producer.send("with default opts");

        *AmqpMessage msg = consumer.receive(10s);
        @assert(msg);
        assertEq("with default opts", msg.getBody());
    }

    # --- AmqpConsumer ---

    testConsumerReceive() {
        string addr = getUniqueAddress();
        AmqpClient client = getClient();
        on_exit client.close();

        AmqpConsumer consumer = client.createConsumer(addr);
        @assert(consumer.getReceiverName());

        client.send(addr, "consumer msg");
        *AmqpMessage msg = consumer.receive(10s);
        @assert(msg);
        assertEq("consumer msg", msg.getBody());
    }

    testConsumerAccept() {
        string addr = getUniqueAddress();
        AmqpClient client = getClient();
        on_exit client.close();

        AmqpProducer producer = client.createProducer(addr);
        AmqpConsumer consumer = client.createConsumer(addr);

        producer.send("accept-via-consumer");
        *AmqpMessage msg = consumer.receive(10s);
        @assert(msg);
        assertEq("accept-via-consumer", msg.getBody());

        # Get delivery tag from message and accept via consumer
        *binary tag = msg.getDeliveryTag();
        @assert(tag);
        assertTrue(tag.size() > 0);
        consumer.accept(tag);

        # No more messages
        *AmqpMessage msg2 = consumer.receive(2s);
        assertNothing(msg2);
    }

    testConsumerMultiple() {
        string addr = getUniqueAddress();
        AmqpClient client = getClient();
        on_exit client.close();

        AmqpProducer producer = client.createProducer(addr);
        AmqpConsumer consumer = client.createConsumer(addr);

        for (int i = 0; i < 5; ++i) {
            producer.send(sprintf("msg-%d", i));
        }

        for (int i = 0; i < 5; ++i) {
            *AmqpMessage msg = consumer.receive(10s);
            @assert(msg);
            assertEq(sprintf("msg-%d", i), msg.getBody());
        }
    }

    testConsumerIsDurable() {
        AmqpClient client = getClient();
        on_exit client.close();

        # Non-durable consumer
        string addr = getUniqueAddress();
        AmqpConsumer consumer = client.createConsumer(addr);
        assertEq(False, consumer.isDurable());
        assertNothing(consumer.getSubscriptionName());
    }

    testConsumerNonDurableCloseThrows() {
        AmqpClient client = getClient();
        on_exit client.close();

        string addr = getUniqueAddress();
        AmqpConsumer consumer = client.createConsumer(addr);
        assertThrows("AMQP-CONSUMER-ERROR", sub() {
            consumer.closeDurable();
        });
    }

    testConsumerNonDurableUnsubscribeThrows() {
        AmqpClient client = getClient();
        on_exit client.close();

        string addr = getUniqueAddress();
        AmqpConsumer consumer = client.createConsumer(addr);
        assertThrows("AMQP-CONSUMER-ERROR", sub() {
            consumer.unsubscribe();
        });
    }

    # --- AmqpRequestReply ---

    testRequestReply() {
        string request_addr = getUniqueAddress();
        AmqpClient client = getClient();
        on_exit client.close();

        # Set up a "server" that receives on request_addr and sends a reply
        AmqpConnection conn = client.getConnection();
        string req_receiver = conn.createReceiver(request_addr);

        # Create request-reply helper
        AmqpRequestReply rr(client, request_addr);

        # In a background thread, act as the responder
        Counter done(1);
        background sub() {
            on_exit done.dec();
            *AmqpMessage req = conn.receive(req_receiver, 10s);
            if (req) {
                # Send reply to the reply_to address with correlation_id
                auto reply_to = req.getReplyTo();
                auto msg_id = req.getMessageId();
                if (reply_to && msg_id) {
                    string reply_sender = conn.createSender(reply_to);
                    conn.send(reply_sender, new AmqpMessage("pong", <AmqpMessageProperties>{
                        "correlation_id": msg_id,
                    }));
                }
            }
        }();

        AmqpMessage response = rr.request("ping", 10s);
        assertEq("pong", response.getBody());

        done.waitForZero(10s);
        rr.close();
    }

    testRequestReplyTimeout() {
        string addr = getUniqueAddress();
        AmqpClient client = getClient();
        on_exit client.close();

        AmqpRequestReply rr(client, addr);
        # No responder — should timeout
        assertThrows("AMQP-REQUEST-REPLY-TIMEOUT", sub() {
            rr.request("ping", 2s);
        });
        rr.close();
    }

    # --- AmqpProducer extended ---

    testProducerSendBatch() {
        string addr = getUniqueAddress();
        AmqpClient client = getClient();
        on_exit client.close();

        # Create receiver before sending so messages aren't discarded
        AmqpConsumer consumer = client.createConsumer(addr);
        AmqpProducer producer = client.createProducer(addr);
        list<hash<AmqpDeliveryInfo>> results = producer.sendBatch(("batch-1", "batch-2", "batch-3"));
        assertEq(3, results.size());

        for (int i = 0; i < 3; ++i) {
            *AmqpMessage msg = consumer.receive(10s);
            @assert(msg);
            assertEq(sprintf("batch-%d", i + 1), msg.getBody());
        }
    }

    testProducerClose() {
        string addr = getUniqueAddress();
        AmqpClient client = getClient();
        on_exit client.close();

        # Create receiver first so the queue exists
        AmqpConsumer consumer = client.createConsumer(addr);
        AmqpProducer producer = client.createProducer(addr);
        producer.send("before close");
        producer.close();

        # Verify the message sent before close is still deliverable
        *AmqpMessage msg = consumer.receive(10s);
        @assert(msg);
        assertEq("before close", msg.getBody());
    }

    # --- AmqpConsumer extended ---

    testConsumerClose() {
        string addr = getUniqueAddress();
        AmqpClient client = getClient();
        on_exit client.close();

        # Send a message, consume it, then close the consumer
        AmqpConsumer consumer = client.createConsumer(addr);
        client.send(addr, "close-test");
        *AmqpMessage msg = consumer.receive(10s);
        @assert(msg);
        assertEq("close-test", msg.getBody());
        consumer.close();

        # After close, creating a new consumer on the same address works
        AmqpConsumer consumer2 = client.createConsumer(addr);
        @assert(consumer2.getReceiverName());
    }

    testConsumerReject() {
        string addr = getUniqueAddress();
        AmqpClient client = getClient();
        on_exit client.close();

        # Create consumer first so messages aren't discarded
        AmqpConsumer consumer = client.createConsumer(addr);
        client.send(addr, "reject-test");
        *AmqpMessage msg = consumer.receive(10s);
        @assert(msg);
        consumer.reject(msg.getDeliveryTag());
    }

    testConsumerRelease() {
        string addr = getUniqueAddress();
        AmqpClient client = getClient();
        on_exit client.close();

        AmqpConsumer consumer = client.createConsumer(addr);
        client.send(addr, "release-test");
        *AmqpMessage msg = consumer.receive(10s);
        @assert(msg);
        consumer.release(msg.getDeliveryTag());

        # Message should be redelivered after release
        *AmqpMessage msg2 = consumer.receive(10s);
        @assert(msg2);
        assertEq("release-test", msg2.getBody());
        consumer.accept(msg2.getDeliveryTag());
    }

    # --- AmqpClient link close ---

    testClientCloseSender() {
        string addr = getUniqueAddress();
        AmqpClient client = getClient();
        on_exit client.close();

        # Ensure receiver exists first
        *AmqpMessage warmup = client.receive(addr, 1s);
        client.send(addr, "before close");
        client.closeSender(addr);
        # Sending again creates a new sender (lazy recreation)
        client.send(addr, "after close");
        *AmqpMessage msg = client.receive(addr, 10s);
        @assert(msg);
    }

    testClientCloseReceiver() {
        string addr = getUniqueAddress();
        AmqpClient client = getClient();
        on_exit client.close();

        client.send(addr, "test");
        *AmqpMessage msg = client.receive(addr, 5s);
        @assert(msg);
        assertEq("test", msg.getBody());
        client.closeReceiver(addr);

        # After close, receiving again creates a new receiver (lazy recreation)
        client.send(addr, "after close");
        *AmqpMessage msg2 = client.receive(addr, 10s);
        @assert(msg2);
        assertEq("after close", msg2.getBody());
    }

    # --- AmqpClient batch and shared ---

    testClientSendBatch() {
        string addr = getUniqueAddress();
        AmqpClient client = getClient();
        on_exit client.close();

        # Create receiver first
        *AmqpMessage warmup = client.receive(addr, 1s);
        list<hash<AmqpDeliveryInfo>> results = client.sendBatch(addr, ("b1", "b2", "b3"));
        assertEq(3, results.size());

        for (int i = 0; i < 3; ++i) {
            *AmqpMessage msg = client.receive(addr, 10s);
            @assert(msg);
        }
    }

    testClientCreateSharedConsumer() {
        string addr = getUniqueAddress();
        AmqpClient client = getClient();
        on_exit client.close();

        # Create shared consumer — should not throw
        AmqpConsumer consumer = client.createSharedConsumer(addr, "shared-sub");
        @assert(consumer);
        consumer.close();
    }

    # --- AmqpClient auto-convert ---

    testClientAutoConvert() {
        string addr = getUniqueAddress();
        AmqpClient client = getClient();
        on_exit client.close();

        client.setAutoConvert(True);

        # Create receiver first
        *hash<auto> warmup = client.receiveAndDecode(addr, 1s);

        # Send JSON-encoded message via auto-convert
        hash<auto> data = {"order_id": 42, "item": "widget"};
        client.send(addr, data, <AmqpMessageProperties>{"content_type": "application/json"});

        # Receive and auto-decode
        *hash<auto> result = client.receiveAndDecode(addr, 10s);
        @assert(result);
        assertEq(42, result.body.order_id);
        assertEq("widget", result.body.item);
        @assert(result.msg);
    }

    # --- AmqpClient durable consumer ---

    testClientDurableConsumer() {
        string addr = getUniqueAddress();
        AmqpClient client = getClient();
        on_exit client.close();

        # Create durable consumer
        AmqpConsumer consumer = client.createDurableConsumer(addr, "durable-sub");
        assertTrue(consumer.isDurable());
        assertEq("durable-sub", consumer.getSubscriptionName());
        consumer.closeDurable();
    }

    # --- AmqpManagementClient ---

    testManagementQueryAddresses() {
        AmqpClient client = getClient();
        on_exit client.close();

        # Create an address by sending a message
        string addr = getUniqueAddress();
        client.send(addr, "mgmt test");

        AmqpManagementClient mgmt = client.getManagementClient();
        list<hash<AmqpAddressInfo>> addresses = mgmt.queryAddresses();
        # Should return a list (possibly empty if management not supported)
        assertEq(NT_LIST, addresses.typeCode());
    }

    testManagementQueryQueues() {
        AmqpClient client = getClient();
        on_exit client.close();

        AmqpManagementClient mgmt = client.getManagementClient();
        list<hash<AmqpQueueInfo>> queues = mgmt.queryQueues();
        assertEq(NT_LIST, queues.typeCode());
    }

    # --- Transaction pass-through ---

    testClientTransaction() {
        AmqpClient client = getClient();
        on_exit client.close();

        assertEq(False, client.inTransaction());
        client.beginTransaction();
        assertEq(True, client.inTransaction());
        client.commitTransaction();
        assertEq(False, client.inTransaction());
    }

    testClientTxnCommit() {
        string addr = getUniqueAddress();
        AmqpClient client = getClient();
        on_exit client.close();

        # Pre-create sender/receiver so they're on the session before the transaction
        client.send(addr, "warmup");
        *AmqpMessage warmup = client.receive(addr, 5s);

        # Transacted send + commit delivers the message
        client.beginTransaction();
        client.send(addr, "txn-client-commit");
        client.commitTransaction();

        *AmqpMessage msg = client.receive(addr, 10s);
        @assert(msg);
        assertEq("txn-client-commit", msg.getBody());
    }

    testClientTxnRollback() {
        string addr = getUniqueAddress();
        AmqpClient client = getClient();
        on_exit client.close();

        # Pre-create sender/receiver
        client.send(addr, "warmup");
        *AmqpMessage warmup = client.receive(addr, 5s);

        # Transacted send + rollback discards the message
        client.beginTransaction();
        client.send(addr, "txn-client-rollback");
        client.rollbackTransaction();

        *AmqpMessage msg = client.receive(addr, 3s);
        assertNothing(msg);
    }

    testClientTxnCommitNoBegin() {
        AmqpClient client = getClient();
        on_exit client.close();

        assertThrows("AMQP-TRANSACTION-ERROR", sub() {
            client.commitTransaction();
        });
    }

    testClientTxnRollbackNoBegin() {
        AmqpClient client = getClient();
        on_exit client.close();

        assertThrows("AMQP-TRANSACTION-ERROR", sub() {
            client.rollbackTransaction();
        });
    }
}
