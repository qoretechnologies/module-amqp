%modern

%requires QUnit
%requires amqp

%exec-class AmqpIntegrationTest

public class AmqpIntegrationTest inherits QUnit::Test {
    private {
        *string url;
        int test_counter = 0;
    }

    constructor() : Test("AmqpIntegrationTest", "1.0") {
        url = ENV.AMQP_TEST_URL;
        if (!url) {
            printf("AMQP_TEST_URL not set, skipping integration tests\n");
            set_return_value(0);
            return;
        }

        # Connection lifecycle
        addTestCase("connect and disconnect", \testConnectDisconnect());
        addTestCase("isConnected state", \testIsConnected());
        addTestCase("multiple connections", \testMultipleConnections());
        addTestCase("connect to invalid host", \testConnectInvalidHost());

        # Send/receive basics
        addTestCase("send and receive string", \testSendReceiveString());
        addTestCase("send and receive binary", \testSendReceiveBinary());
        addTestCase("send and receive hash", \testSendReceiveHash());
        addTestCase("send and receive list", \testSendReceiveList());
        addTestCase("send and receive int", \testSendReceiveInt());
        addTestCase("send and receive with properties", \testSendReceiveProperties());
        addTestCase("send and receive with all properties", \testSendReceiveAllProperties());
        addTestCase("send and receive empty body", \testSendReceiveEmptyBody());
        addTestCase("send and receive large message", \testSendReceiveLargeMessage());
        addTestCase("receive timeout", \testReceiveTimeout());

        # Multiple messages
        addTestCase("send and receive multiple", \testSendReceiveMultiple());

        # Delivery disposition
        addTestCase("accept message", \testAcceptMessage());
        addTestCase("reject message", \testRejectMessage());
        addTestCase("release and redeliver", \testReleaseAndRedeliver());

        # Delivery tag
        addTestCase("delivery tag present", \testDeliveryTagPresent());
        addTestCase("delivery tag unique", \testDeliveryTagUnique());

        # Modify disposition
        addTestCase("modify message", \testModifyMessage());

        # Link close
        addTestCase("close sender", \testCloseSender());
        addTestCase("close receiver", \testCloseReceiver());
        addTestCase("close nonexistent sender throws", \testCloseNonexistentSender());

        # Statistics
        addTestCase("statistics after send/receive", \testStatistics());
        addTestCase("connected_since is set", \testConnectedSince());

        # Transaction tests
        addTestCase("transaction commit without begin throws", \testTxnCommitWithoutBegin());
        addTestCase("transaction rollback without begin throws", \testTxnRollbackWithoutBegin());
        addTestCase("transaction begin and commit", \testTxnBeginCommit());
        addTestCase("transaction begin and rollback", \testTxnBeginRollback());
        addTestCase("transaction begin twice throws", \testTxnBeginTwice());
        addTestCase("transacted send commit delivers", \testTxnSendCommit());
        addTestCase("transacted send rollback discards", \testTxnSendRollback());

        # Batch send
        addTestCase("batch send 10 messages", \testBatchSend());
        addTestCase("batch send empty list", \testBatchSendEmpty());

        # Shared subscriptions
        addTestCase("shared subscription option", \testSharedSubscription());

        # Connection events
        addTestCase("connected event on connect", \testConnectedEvent());
        addTestCase("disconnected event on close", \testDisconnectedEvent());

        # Management protocol
        addTestCase("queryAddresses returns list", \testQueryAddresses());
        addTestCase("queryQueues returns list", \testQueryQueues());
        addTestCase("getAddressInfo returns hash or nothing", \testGetAddressInfo());
        addTestCase("getQueueInfo returns hash or nothing", \testGetQueueInfo());

        set_return_value(main());
    }

    private string getUniqueAddress() {
        return sprintf("test-amqp-%d-%d", getpid(), ++test_counter);
    }

    private AmqpConnection getConnection() {
        AmqpConnection conn(<AmqpConnectionOptions>{
            "url": url,
        });
        conn.connect();
        return conn;
    }

    # --- Connection lifecycle ---

    testConnectDisconnect() {
        AmqpConnection conn(<AmqpConnectionOptions>{"url": url});
        conn.connect();
        assertEq(True, conn.isConnected());
        conn.close();
        assertEq(False, conn.isConnected());
    }

    testIsConnected() {
        AmqpConnection conn(<AmqpConnectionOptions>{"url": url});
        assertEq(False, conn.isConnected());
        conn.connect();
        assertEq(True, conn.isConnected());
        conn.close();
        assertEq(False, conn.isConnected());
    }

    testMultipleConnections() {
        AmqpConnection conn1(<AmqpConnectionOptions>{"url": url});
        AmqpConnection conn2(<AmqpConnectionOptions>{"url": url});
        conn1.connect();
        conn2.connect();
        assertEq(True, conn1.isConnected());
        assertEq(True, conn2.isConnected());
        conn1.close();
        conn2.close();
    }

    testConnectInvalidHost() {
        assertThrows("AMQP-CONNECTION-ERROR", sub() {
            AmqpConnection conn(<AmqpConnectionOptions>{
                "url": "amqp://nonexistent.invalid:5672",
            });
            conn.connect();
        });
    }

    # --- Send/receive basics ---

    testSendReceiveString() {
        string addr = getUniqueAddress();
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        string sender = conn.createSender(addr);
        string receiver = conn.createReceiver(addr);

        conn.send(sender, new AmqpMessage("Hello, AMQP!"));
        *AmqpMessage msg = conn.receive(receiver, 10s);
        @assert(msg);
        assertEq("Hello, AMQP!", msg.getBody());
    }

    testSendReceiveBinary() {
        string addr = getUniqueAddress();
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        string sender = conn.createSender(addr);
        string receiver = conn.createReceiver(addr);

        binary b = <deadbeef0102>;
        conn.send(sender, new AmqpMessage(b));
        *AmqpMessage msg = conn.receive(receiver, 10s);
        @assert(msg);
        assertEq(b, msg.getBody());
    }

    testSendReceiveHash() {
        string addr = getUniqueAddress();
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        string sender = conn.createSender(addr);
        string receiver = conn.createReceiver(addr);

        hash<auto> h = {"key": "value", "num": 42, "flag": True};
        conn.send(sender, new AmqpMessage(h));
        *AmqpMessage msg = conn.receive(receiver, 10s);
        @assert(msg);
        hash<auto> body = msg.getBody();
        assertEq("value", body.key);
        assertEq(42, body.num);
        assertEq(True, body.flag);
    }

    testSendReceiveList() {
        string addr = getUniqueAddress();
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        string sender = conn.createSender(addr);
        string receiver = conn.createReceiver(addr);

        list<auto> l = ("one", 2, True);
        conn.send(sender, new AmqpMessage(l));
        *AmqpMessage msg = conn.receive(receiver, 10s);
        @assert(msg);
        list<auto> body = msg.getBody();
        assertEq(3, body.size());
        assertEq("one", body[0]);
        assertEq(2, body[1]);
        assertEq(True, body[2]);
    }

    testSendReceiveInt() {
        string addr = getUniqueAddress();
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        string sender = conn.createSender(addr);
        string receiver = conn.createReceiver(addr);

        conn.send(sender, new AmqpMessage(99999));
        *AmqpMessage msg = conn.receive(receiver, 10s);
        @assert(msg);
        assertEq(99999, msg.getBody());
    }

    testSendReceiveProperties() {
        string addr = getUniqueAddress();
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        string sender = conn.createSender(addr);
        string receiver = conn.createReceiver(addr);

        conn.send(sender, new AmqpMessage("prop test", <AmqpMessageProperties>{
            "content_type": "text/plain",
            "message_id": "msg-integration-001",
            "correlation_id": "corr-001",
            "subject": "test-subject",
            "reply_to": "reply-addr",
            "application_properties": {"color": "blue", "priority": 5},
        }));

        *AmqpMessage msg = conn.receive(receiver, 10s);
        @assert(msg);
        assertEq("prop test", msg.getBody());
        assertEq("text/plain", msg.getContentType());
        assertEq("msg-integration-001", msg.getMessageId());
        assertEq("corr-001", msg.getCorrelationId());
        assertEq("test-subject", msg.getSubject());
        assertEq("reply-addr", msg.getReplyTo());
        hash<auto> app_props = msg.getApplicationProperties();
        assertEq("blue", app_props.color);
        assertEq(5, app_props.priority);
    }

    testSendReceiveAllProperties() {
        string addr = getUniqueAddress();
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        string sender = conn.createSender(addr);
        string receiver = conn.createReceiver(addr);

        date creation = Qore::now_us();
        conn.send(sender, new AmqpMessage("all props", <AmqpMessageProperties>{
            "message_id": "all-props-id",
            "correlation_id": "all-props-corr",
            "reply_to": "all-props-reply",
            "content_type": "application/json",
            "content_encoding": "utf-8",
            "subject": "all-props-subject",
            "to": addr,
            "group_id": "group-1",
            "group_sequence": 7,
            "reply_to_group_id": "reply-group-1",
            "creation_time": creation,
        }));

        *AmqpMessage msg = conn.receive(receiver, 10s);
        @assert(msg);
        hash<AmqpMessageProperties> props = msg.getProperties();
        assertEq("all-props-id", props.message_id);
        assertEq("all-props-corr", props.correlation_id);
        assertEq("all-props-reply", props.reply_to);
        assertEq("application/json", props.content_type);
        assertEq("utf-8", props.content_encoding);
        assertEq("all-props-subject", props.subject);
        assertEq("group-1", props.group_id);
        assertEq(7, props.group_sequence);
        assertEq("reply-group-1", props.reply_to_group_id);
        # creation_time round-trips in UTC with millisecond precision
        # AMQP timestamps have ms precision, so compare epoch ms values
        int expected_ms = get_epoch_seconds(creation) * 1000 + creation.microseconds() / 1000;
        int actual_ms = get_epoch_seconds(props.creation_time) * 1000 + props.creation_time.microseconds() / 1000;
        assertEq(expected_ms, actual_ms);
    }

    testSendReceiveEmptyBody() {
        string addr = getUniqueAddress();
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        string sender = conn.createSender(addr);
        string receiver = conn.createReceiver(addr);

        conn.send(sender, new AmqpMessage());
        *AmqpMessage msg = conn.receive(receiver, 10s);
        @assert(msg);
        assertNothing(msg.getBody());
    }

    testSendReceiveLargeMessage() {
        string addr = getUniqueAddress();
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        string sender = conn.createSender(addr);
        string receiver = conn.createReceiver(addr);

        string large = strmul("A", 100000);  # 100KB
        conn.send(sender, new AmqpMessage(large));
        *AmqpMessage msg = conn.receive(receiver, 30s);
        @assert(msg);
        assertEq(100000, msg.getBody().size());
        assertEq(large, msg.getBody());
    }

    testReceiveTimeout() {
        string addr = getUniqueAddress();
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        string receiver = conn.createReceiver(addr);
        # Receive with short timeout on empty queue
        *AmqpMessage msg = conn.receive(receiver, 1s);
        assertNothing(msg);
    }

    # --- Multiple messages ---

    testSendReceiveMultiple() {
        string addr = getUniqueAddress();
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        string sender = conn.createSender(addr);
        string receiver = conn.createReceiver(addr);

        # Send 10 messages
        for (int i = 0; i < 10; ++i) {
            conn.send(sender, new AmqpMessage(sprintf("msg-%d", i)));
        }

        # Receive all 10
        for (int i = 0; i < 10; ++i) {
            *AmqpMessage msg = conn.receive(receiver, 10s);
            @assert(msg);
            assertEq(sprintf("msg-%d", i), msg.getBody());
        }
    }

    # --- Delivery disposition ---

    testAcceptMessage() {
        string addr = getUniqueAddress();
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        string sender = conn.createSender(addr);
        string receiver = conn.createReceiver(addr);

        conn.send(sender, new AmqpMessage("accept-test"));
        *AmqpMessage msg = conn.receive(receiver, 10s);
        @assert(msg);
        assertEq("accept-test", msg.getBody());

        # Get delivery tag and accept the message
        *binary tag = msg.getDeliveryTag();
        @assert(tag);
        assertTrue(tag.size() > 0);
        conn.accept(tag);

        # Verify the message is consumed (no more messages)
        *AmqpMessage msg2 = conn.receive(receiver, 2s);
        assertNothing(msg2);
    }

    testRejectMessage() {
        string addr = getUniqueAddress();
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        string sender = conn.createSender(addr);
        string receiver = conn.createReceiver(addr);

        conn.send(sender, new AmqpMessage("reject-test"));
        *AmqpMessage msg = conn.receive(receiver, 10s);
        @assert(msg);
        assertEq("reject-test", msg.getBody());

        # Reject the message
        *binary tag = msg.getDeliveryTag();
        @assert(tag);
        conn.reject(tag);
    }

    testReleaseAndRedeliver() {
        string addr = getUniqueAddress();
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        string sender = conn.createSender(addr);
        string receiver = conn.createReceiver(addr);

        conn.send(sender, new AmqpMessage("release-test"));
        *AmqpMessage msg = conn.receive(receiver, 10s);
        @assert(msg);
        assertEq("release-test", msg.getBody());

        # Release the message for redelivery
        *binary tag = msg.getDeliveryTag();
        @assert(tag);
        conn.release(tag);

        # Message should be redelivered
        *AmqpMessage msg2 = conn.receive(receiver, 10s);
        @assert(msg2);
        assertEq("release-test", msg2.getBody());
        # Accept it this time
        conn.accept(msg2.getDeliveryTag());
    }

    # --- Delivery tag tests ---

    testDeliveryTagPresent() {
        string addr = getUniqueAddress();
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        string sender = conn.createSender(addr);
        string receiver = conn.createReceiver(addr);

        conn.send(sender, new AmqpMessage("delivery-tag-test"));
        *AmqpMessage msg = conn.receive(receiver, 10s);
        @assert(msg);

        # Received messages must have a delivery tag
        *binary tag = msg.getDeliveryTag();
        @assert(tag);
        assertTrue(tag.size() > 0);

        # Accept to clean up
        conn.accept(tag);
    }

    # --- Link close ---

    testCloseSender() {
        string addr = getUniqueAddress();
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        string sender = conn.createSender(addr);
        conn.closeSender(sender);

        # Sending on closed sender should throw
        assertThrows("AMQP-SEND-ERROR", sub() {
            conn.send(sender, new AmqpMessage("should fail"));
        });
    }

    testCloseReceiver() {
        string addr = getUniqueAddress();
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        string receiver = conn.createReceiver(addr);
        conn.closeReceiver(receiver);

        # Receiving on closed receiver should throw
        assertThrows("AMQP-RECEIVE-ERROR", sub() {
            conn.receive(receiver, 1s);
        });
    }

    testCloseNonexistentSender() {
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        assertThrows("AMQP-SENDER-ERROR", sub() {
            conn.closeSender("nonexistent-sender");
        });
    }

    # --- Statistics ---

    testStatistics() {
        string addr = getUniqueAddress();
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        string sender = conn.createSender(addr);
        string receiver = conn.createReceiver(addr);

        # Send 3 messages
        conn.send(sender, new AmqpMessage("stat-1"));
        conn.send(sender, new AmqpMessage("stat-2"));
        conn.send(sender, new AmqpMessage("stat-3"));

        # Receive them
        for (int i = 0; i < 3; ++i) {
            *AmqpMessage msg = conn.receive(receiver, 10s);
            @assert(msg);
            conn.accept(msg.getDeliveryTag());
        }

        hash<AmqpConnectionStats> stats = conn.getStatistics();
        assertTrue(stats.messages_sent >= 3);
        assertTrue(stats.messages_received >= 3);
        assertTrue(stats.link_count >= 2);
    }

    testConnectedSince() {
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        hash<AmqpConnectionStats> stats = conn.getStatistics();
        @assert(stats.connected_since);
        # connected_since should be recent (within last 30 seconds)
        assertTrue(now_us() - stats.connected_since < 30s);
    }

    # --- Modify disposition ---

    testModifyMessage() {
        string addr = getUniqueAddress();
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        string sender = conn.createSender(addr);
        string receiver = conn.createReceiver(addr);

        conn.send(sender, new AmqpMessage("modify-test"));
        *AmqpMessage msg = conn.receive(receiver, 10s);
        @assert(msg);
        assertEq("modify-test", msg.getBody());

        # Modify the message (marks for redelivery with annotations)
        *binary tag = msg.getDeliveryTag();
        @assert(tag);
        conn.modify(tag, True, False);

        # Message should be redelivered after modify
        *AmqpMessage msg2 = conn.receive(receiver, 10s);
        @assert(msg2);
        assertEq("modify-test", msg2.getBody());
        conn.accept(msg2.getDeliveryTag());
    }

    # --- Transaction tests ---

    testTxnCommitWithoutBegin() {
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        assertThrows("AMQP-TRANSACTION-ERROR", sub() {
            conn.commitTransaction();
        });
    }

    testTxnRollbackWithoutBegin() {
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        assertThrows("AMQP-TRANSACTION-ERROR", sub() {
            conn.rollbackTransaction();
        });
    }

    testTxnBeginCommit() {
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        assertEq(False, conn.inTransaction());
        conn.beginTransaction();
        assertEq(True, conn.inTransaction());
        conn.commitTransaction();
        assertEq(False, conn.inTransaction());
    }

    testTxnBeginRollback() {
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        conn.beginTransaction();
        assertEq(True, conn.inTransaction());
        conn.rollbackTransaction();
        assertEq(False, conn.inTransaction());
    }

    testTxnBeginTwice() {
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        conn.beginTransaction();
        on_exit {
            try { conn.rollbackTransaction(); } catch () {}
        }
        assertThrows("AMQP-TRANSACTION-ERROR", sub() {
            conn.beginTransaction();
        });
    }

    testTxnSendCommit() {
        string addr = getUniqueAddress();
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        string sender = conn.createSender(addr);
        string receiver = conn.createReceiver(addr);

        # Send within a transaction and commit — message should be delivered
        conn.beginTransaction();
        conn.send(sender, new AmqpMessage("txn-commit-msg"));
        conn.commitTransaction();

        *AmqpMessage msg = conn.receive(receiver, 10s);
        @assert(msg);
        assertEq("txn-commit-msg", msg.getBody());
        conn.accept(msg.getDeliveryTag());
    }

    testTxnSendRollback() {
        string addr = getUniqueAddress();
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        string sender = conn.createSender(addr);
        string receiver = conn.createReceiver(addr);

        # Send within a transaction and rollback — message should NOT be delivered
        conn.beginTransaction();
        conn.send(sender, new AmqpMessage("txn-rollback-msg"));
        conn.rollbackTransaction();

        *AmqpMessage msg = conn.receive(receiver, 3s);
        assertNothing(msg);
    }

    # --- Batch send ---

    testBatchSend() {
        string addr = getUniqueAddress();
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        string sender = conn.createSender(addr);
        string receiver = conn.createReceiver(addr);

        # Send 10 messages in batch
        list<AmqpMessage> batch = ();
        for (int i = 0; i < 10; ++i) {
            batch += new AmqpMessage(sprintf("batch-%d", i));
        }
        list<hash<AmqpDeliveryInfo>> results = conn.sendBatch(sender, batch);
        assertEq(10, results.size());

        # Receive all 10
        for (int i = 0; i < 10; ++i) {
            *AmqpMessage msg = conn.receive(receiver, 10s);
            @assert(msg);
            assertEq(sprintf("batch-%d", i), msg.getBody());
            conn.accept(msg.getDeliveryTag());
        }
    }

    testBatchSendEmpty() {
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        string sender = conn.createSender("batch-empty-test");
        list<hash<AmqpDeliveryInfo>> results = conn.sendBatch(sender, ());
        assertEq(0, results.size());
    }

    # --- Shared subscriptions ---

    testSharedSubscription() {
        string addr = getUniqueAddress();
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        # Create a receiver with shared option — should not throw
        string receiver = conn.createReceiver(addr, <AmqpReceiveOptions>{
            "shared": True,
        });
        @assert(receiver);
        conn.closeReceiver(receiver);
    }

    # --- Connection events ---

    testConnectedEvent() {
        AmqpConnection conn(<AmqpConnectionOptions>{"url": url});
        conn.connect();
        on_exit conn.close();

        list<hash<auto>> events = conn.getConnectionEvents();
        assertTrue(events.size() >= 1);
        # First event should be "amqp-connected"
        assertEq("amqp-connected", events[0].event);
        @assert(events[0].timestamp);
    }

    testDisconnectedEvent() {
        AmqpConnection conn(<AmqpConnectionOptions>{"url": url});
        conn.connect();
        conn.close();

        list<hash<auto>> events = conn.getConnectionEvents();
        # Should have connected + disconnected events
        assertTrue(events.size() >= 2);
        # Find the disconnected event
        bool found = False;
        foreach hash<auto> ev in (events) {
            if (ev.event == "amqp-disconnected") {
                found = True;
                break;
            }
        }
        assertTrue(found);
    }

    # --- Management protocol ---

    testQueryAddresses() {
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        list<hash<AmqpAddressInfo>> addresses = conn.queryAddresses();
        assertEq(NT_LIST, addresses.typeCode());
        # If management is supported, each entry should have required fields
        for (int i = 0; i < addresses.size(); ++i) {
            @assert(addresses[i].name.val());
            @assert(addresses[i].routing_type.val());
        }
    }

    testQueryQueues() {
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        list<hash<AmqpQueueInfo>> queues = conn.queryQueues();
        assertEq(NT_LIST, queues.typeCode());
        for (int i = 0; i < queues.size(); ++i) {
            @assert(queues[i].name.val());
            @assert(queues[i].routing_type.val());
        }
    }

    testGetAddressInfo() {
        string addr = getUniqueAddress();
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        # Create an address by sending a message
        string sender = conn.createSender(addr);
        conn.send(sender, new AmqpMessage("info-test"));

        # getAddressInfo may return NOTHING if management not supported
        *hash<auto> info = conn.getAddressInfo(addr);
        # Just verify it doesn't throw and returns the right type
        if (info) {
            assertEq(NT_HASH, info.typeCode());
        }
    }

    testGetQueueInfo() {
        string addr = getUniqueAddress();
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        # Create a queue by sending a message
        string sender = conn.createSender(addr);
        conn.send(sender, new AmqpMessage("queue-info-test"));

        *hash<auto> info = conn.getQueueInfo(addr);
        if (info) {
            assertEq(NT_HASH, info.typeCode());
        }
    }

    # --- Delivery tag tests ---

    testDeliveryTagUnique() {
        string addr = getUniqueAddress();
        AmqpConnection conn = getConnection();
        on_exit conn.close();

        string sender = conn.createSender(addr);
        string receiver = conn.createReceiver(addr);

        # Send two messages
        conn.send(sender, new AmqpMessage("msg-1"));
        conn.send(sender, new AmqpMessage("msg-2"));

        # Receive both — delivery tags should be different
        *AmqpMessage msg1 = conn.receive(receiver, 10s);
        @assert(msg1);
        *AmqpMessage msg2 = conn.receive(receiver, 10s);
        @assert(msg2);

        *binary tag1 = msg1.getDeliveryTag();
        *binary tag2 = msg2.getDeliveryTag();
        @assert(tag1);
        @assert(tag2);
        assertTrue(tag1 != tag2);

        conn.accept(tag1);
        conn.accept(tag2);
    }
}
