    @endcode

    @section amqp_ex_reconnect Reconnection with Link Recovery

    When \c reconnect is enabled in connection options and \c auto_recover_links is
    \c True (the default), all senders and receivers are automatically re-created
    when the connection is re-established after a disconnect.

    @code{.py}
AmqpConnection conn(<AmqpConnectionOptions>{
    "url": "amqp://guest:guest@@localhost:5672",
    "reconnect": True,
});
conn.connect();
string sender = conn.createSender("my-queue");
# If the connection drops and reconnects, sender is automatically re-created

conn.setAutoRecoverLinks(False);  # disable auto-recovery if needed
    @endcode

    @section amqp_ex_converter Message Content Converter
    @code{.py}
%modern
%requires AmqpUtil

Amqp::AmqpClient client("amqp://guest:guest@@localhost:5672");
client.connect();
client.setAutoConvert(True);

# Auto-encode: hash is serialized as JSON before sending
client.send("my-queue", {"order_id": 123, "total": 49.99},
    <AmqpMessageProperties>{"content_type": "application/json"});

# Auto-decode: receiveAndDecode parses the JSON body back to a hash
*hash<auto> result = client.receiveAndDecode("my-queue", 5s);
printf("Order: %y\\n", result.body);  # {"order_id": 123, "total": 49.99}

# Supported: application/json, application/yaml, text/yaml, application/xml, text/xml
# Requires the corresponding module (json, yaml, xml) to be installed
    @endcode

    @section amqp_ex_dlq Dead Letter Queue Routing
    @code{.py}
%modern
%requires AmqpUtil

Amqp::AmqpClient client("amqp://guest:guest@@localhost:5672");
client.connect();

# Create a consumer with a DLQ address
Amqp::AmqpConsumer consumer = client.createConsumer("orders", NOTHING, NOTHING, "orders-dlq");

*AmqpMessage msg = consumer.receive(5s);
if (msg) {
    try {
        processOrder(msg.getBody());
        consumer.accept(msg.getDeliveryTag());
    } catch () {
        # Forward to DLQ with rejection metadata, then reject original
        consumer.rejectToDlq(msg.getDeliveryTag(), msg, "processing failed");
    }
}
    @endcode

    @section amqp_ex_urlcreds URL Credential Extraction

    Credentials in the AMQP URL (\c amqp://user:pass@@host) are automatically
    extracted and used for SASL authentication. Explicit \c sasl options in
    @ref Qore::Amqp::AmqpConnectionOptions override URL credentials.

    @code{.py}
# Credentials from URL — no separate sasl options needed
AmqpConnection conn(<AmqpConnectionOptions>{
    "url": "amqp://myuser:mypassword@@broker.example.com:5672",
});
conn.connect();  # authenticates as myuser
    @endcode
